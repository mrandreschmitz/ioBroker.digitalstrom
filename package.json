        "proxyquire": "^2.1.3",
        "react": "^18.3.1",
        "react-dom": "^19.2.8",
        "sinon": "^22.1.0",
        "sinon-chai": "^3.7.0",
        "typescript": "~6.0.3",
        "vite": "^5.4.11"
    },
    "overrides": {
        "serialize-javascript": "^7.1.0",
        "diff": "^8.0.4",
        "esbuild": "^0.28.2"
    },
    "main": "main.js",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "test:js": "mocha --require test/mocha.setup.js \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
        "test:package": "mocha test/package --exit",
        "test:unit": "mocha test/unit --exit",
        "test:integration": "mocha test/integration --exit",
        "test": "npm run test:js && npm run test:package",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "release": "release-script",
        "build:admin": "vite build --config src-admin/vite.config.js && node scripts/adminSourcesHash.cjs",
        "dev:admin": "vite --config src-admin/vite.config.js",
        "build": "npm run build:admin",
        "check:admin": "tsc --noEmit -p src-admin/tsconfig.json"
    },
    "bugs": {
        "url": "https://github.com/mrandreschmitz/ioBroker.digitalstrom/issues"
    },
    "readmeFilename": "README.md"
